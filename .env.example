# =============================================================================
# Apollo Metrics - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================
# Deployment: cp .env.example .env
# Security:   chmod 600 .env
# =============================================================================

# --- Flask Environment ---
# Set to 'production' for live deployment, 'development' for local testing
FLASK_ENV=production
FLASK_DEBUG=0

# --- LLM API (OpenAI-compatible) ---
# Free option: Groq (https://console.groq.com) - no credit card needed
# Paid option: OpenAI, Cerebras, or any OpenAI-compatible API
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.3-70b-versatile
# Alternatives: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=apollo_metrics

# --- Flask Secret Key (REQUIRED) ---
# Generate a secure random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_secure_secret_key
